rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Prefers the `role` custom claim, which is carried on the auth token and
    // costs nothing to read. Falls back to the user document for accounts whose
    // claim has not been set yet, so this is safe to deploy before (or without)
    // running scripts/set-role-claims.js. The ternary is lazy, so the billed
    // get() is skipped entirely whenever a claim is present.
    //
    // The claim wins over the document when both exist, so re-run the script
    // after changing anyone's role or the stale claim will take effect.
    function getUserRole() {
      return 'role' in request.auth.token
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && getUserRole() == 'teacher';
    }

    // One role lookup rather than two. `isAdmin() || isTeacher()` would resolve
    // getUserRole() once per branch.
    function isStaff() {
      return isSignedIn() && getUserRole() in ['admin', 'teacher'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True when an update touches none of the fields outside `fields`. Tolerates
    // fields that are absent on the existing document, which a direct equality
    // comparison does not.
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── Users Collection ───────────────────────────────────

    match /users/{userId} {
      // Two independent allow rules rather than one OR.
      //
      // Reading your own profile is the app's cold-start path: AuthContext
      // fetches it before anything renders. Matching it with `get` alone means
      // isOwner() settles the decision from the path variable, with no billed
      // get() on the very document being read. Folding this into a single
      // `isOwner(userId) || isStaff()` would not work — on a staff *list* query
      // the wildcard is unbound, so that clause is indeterminate.
      allow get: if isOwner(userId);

      // Staff read everything, get and list alike (needed for roster queries).
      allow read: if isStaff();

      // Self-registration (students only)
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'student';

      // Admins may create any account. Teachers may only create students —
      // this is what stops a teacher provisioning an admin account for
      // themselves, since the app already gives them account-creation UI.
      allow create: if isAdmin();
      allow create: if isTeacher() &&
        request.resource.data.role == 'student';

      // Own profile: contact and personal details only. role, teacherIds,
      // batchIds and courseIds are all excluded, so a student cannot grant
      // themselves a role or self-enrol into a batch or course.
      allow update: if isOwner(userId) && changesOnly([
        'name', 'studentPhone', 'phone', 'aadhaar', 'dob', 'address',
        'previousEducation', 'mothersName', 'fathersName', 'guardianName',
        'guardianPhone', 'subject', 'updatedAt'
      ]);

      // Admin can update anything
      allow update: if isAdmin();

      // Teachers may only change batch and course membership, and only for
      // students actually assigned to them.
      allow update: if isTeacher() &&
        resource.data.role == 'student' &&
        'teacherIds' in resource.data &&
        request.auth.uid in resource.data.teacherIds &&
        changesOnly(['batchIds', 'courseIds']);

      // Only admin can delete users
      allow delete: if isAdmin();
    }

    // ─── Batches Collection ─────────────────────────────────

    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── Courses Collection ─────────────────────────────────

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ─── Test Reports Collection ────────────────────────────

    match /testReports/{reportId} {
      // Staff can read all, students only their own.
      //
      // NOTE: putting `resource.data.studentId == request.auth.uid` first would
      // save students a billed role lookup, but on unfiltered staff queries that
      // clause is indeterminate and the OR would rely on CEL error absorption to
      // still resolve via isStaff(). Validate in the emulator before reordering
      // — a mistake here breaks every staff list query.
      allow read: if isSignedIn() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );

      allow create: if isStaff();
      allow update, delete: if isAdmin() ||
        (isTeacher() && resource.data.createdBy == request.auth.uid);
    }

    // ─── Attendance Collection ──────────────────────────────

    match /attendance/{recordId} {
      // Staff can read all, students only their own. See the ordering note on
      // testReports before changing the clause order here.
      allow read: if isSignedIn() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );

      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─── Fees Collection ────────────────────────────────────

    match /fees/{feeId} {
      // Staff can read all, students only their own. See the ordering note on
      // testReports before changing the clause order here.
      //
      // Teachers hold a blanket read here, so scoping a teacher to their own
      // students' fees is enforced in the app (FeeForm), not in these rules.
      // Tightening it at this layer needs `teacherIds` denormalised onto fee
      // documents, which requires a backfill over existing data.
      allow read: if isSignedIn() && (
        isStaff() || resource.data.studentId == request.auth.uid
      );

      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
